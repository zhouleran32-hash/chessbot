# Copy this file to .env and fill in your settings.
OPENAI_API_KEY=

# Use stockfish from PATH, or set the full path to your Stockfish executable.
STOCKFISH_PATH=stockfish

CHESS_COM_USERNAME=
CHESS_COM_RATING=

# Focus on game analysis and feedback. Set false to show books and weekly plans.
CHESSBOT_REVIEW_ONLY=true

# Optional: use an Anthropic client for coaching instead of OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
